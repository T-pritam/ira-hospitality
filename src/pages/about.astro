---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import FounderCard from '../components/FounderCard.astro';
import { img } from '../data/images';
import { founders } from '../data/people';

const pillars = [
  { title: 'Industry Expertise', text: 'A seasoned team with decades of experience in global hospitality.' },
  { title: 'Innovative Approach', text: 'Data-driven strategies that enhance guest satisfaction and ROI.' },
  { title: 'Customized Solutions', text: 'Every project is tailored to its market and to the brand’s vision.' },
];
---
<Base
  title="About Us"
  description="Ira Hospitality curates extraordinary hospitality experiences, with bespoke solutions that turn hotels, restaurants and lifestyle spaces into profitable, guest-centric destinations. Meet founders Suhasini and Siddarth."
  headerTheme="light"
  label="About Us"
  footerCta={false}
>
  <PageHero crumbs={[{ label: 'About' }]} cue={{ label: 'Our team', href: '#team' }}>
    Meet <span class="light">Our Creative</span> Team
    <Fragment slot="lead">Welcome to Ira Hospitality, redefining hospitality excellence.</Fragment>
  </PageHero>

  <section class="section theme-light" data-theme-section="light" aria-labelledby="about-title">
    <div class="container">
      <h2 class="sr-only" id="about-title">About Us</h2>
      <div class="pin-scene" data-pin>
        <span class="orb" aria-hidden="true"></span>
        <p class="studio__statement" data-words>
        We specialise in <strong>curating extraordinary hospitality experiences</strong> and <strong>bespoke solutions</strong> that turn <strong>hotels, restaurants and lifestyle spaces</strong> into profitable, guest-centric destinations.
        </p>
      </div>
      <div class="studio__grid">
        <div class="media studio__media" data-clip>
          <Picture src={img('indian-durbar-16.jpg')} alt="Hands holding the Indian Durbar menu, a project by Ira Hospitality" widths={[480, 800]} sizes="(min-width: 900px) 45vw, 92vw" formats={['avif', 'webp']} class="parallax-img" data-parallax />
        </div>
        <div class="studio__note" data-reveal>
          <p>With a team of industry leaders, we bring <strong style="color:var(--black);font-weight:600">innovation, strategy and operational excellence</strong> to every project.</p>
          <p style="font-size:var(--fs-lead);font-weight:400;color:var(--muted)">The result: world-class standards in <strong style="color:var(--black);font-weight:600">hospitality management, concept development and brand positioning</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-dark tile" data-theme-section="dark" aria-labelledby="why-title">
    <div class="aurora" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container">
      <div class="section-head"><h2 class="h2" id="why-title" data-split>Why Choose <span class="light">Us?</span></h2></div>
      <div class="pillars" data-bento>
        {pillars.map((p, i) => (
          <div class="pillar glass" data-glow data-tilt>
            <span class="pillar__num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-light" id="team" data-theme-section="light" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>The founders of our agency</p>
        <h2 class="h2" id="team-title" data-split>Shaping the Future <span class="light">of Hospitality</span></h2>
        <p data-reveal>Ira Hospitality is led by Suhasini and Siddarth, whose combined experience bridges brand thinking, culinary insight and commercial execution across hospitality.</p>
      </div>
      <div class="founders-grid">
        {founders.map((f, i) => <FounderCard founder={f} id={`f-${i}`} brands={false} />)}
      </div>
      <div class="base" data-reveal>
        <p><strong>Let’s build something remarkable!</strong> Whether you’re launching a new hotel, revamping a restaurant or seeking strategic growth, we are your trusted hospitality partners.</p>
        <Button href="/services/">Our services</Button>
      </div>
    </div>
  </section>

  <CtaBand>Ready to bring your ideas to life? <span class="light muted">We’re here to help</span></CtaBand>
</Base>
