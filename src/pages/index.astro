---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FounderCard from '../components/FounderCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { img } from '../data/images';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { founders, testimonials, clientNames } from '../data/people';
import { site } from '../data/site';

const reelProjects = projects.filter((p) => p.cover);
const half = Math.ceil(clientNames.length / 2);
const clientRows = [clientNames.slice(0, half), clientNames.slice(half)];

// Five pieces of client work, fanned out under the headline.
const fan = [
  { src: 'dessert-kart-4.jpg', alt: 'Stacked pastel Dessert Kart dessert cups' },
  { src: 'og-green-5.jpg', alt: 'OG Green branded takeaway bag at a picnic' },
  { src: 'indian-durbar-16.jpg', alt: 'Hands holding the Indian Durbar menu' },
  { src: 'say-cheese-pi7-image-tool-1.jpg', alt: 'Say Cheese brand visual with hands kneading dough' },
  { src: 'unamas-thumbnail.jpg', alt: 'Unamas chef mascot illustration' },
];
---
<Base headerTheme="light" preloader footerCta={false}>
  <!-- 1 · Hero -->
  <section class="hero" data-theme-section="light" data-hero aria-labelledby="hero-title">
    <div class="aurora" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container hero__inner">
      <p class="pill-label glass" data-intro><span class="dot" aria-hidden="true"></span>Headquartered in Hyderabad, India · Operating globally</p>
      <h1 class="hero__title" id="hero-title" data-split="intro">
        Designed <span class="light">for the Guest,</span><br />
        Built <span class="light">for the Brand.</span>
      </h1>
      <p class="hero__copy" data-intro>
        We position hospitality brands for impact through storytelling, strategy and soul. Every element, from identity to experience, is curated to inspire loyalty and elevate perception.
      </p>
      <div class="hero__actions" data-intro>
        <Button href="/services/">What we do</Button>
        <Button href="/contact/" variant="ghost">Let’s build your brand</Button>
      </div>
    </div>
    <div class="hero__stage" data-intro>
      <div class="fan" data-fan>
        {fan.map((f, i) => (
          <div class="fan__card">
            <Picture src={img(f.src)} alt={f.alt} widths={[280, 420, 560]} sizes="(min-width: 800px) 18vw, 35vw" formats={['avif', 'webp']} loading="eager" fetchpriority={i === 2 ? 'high' : undefined} />
          </div>
        ))}
      </div>
      <nav class="hero__dock glass" aria-label="Services">
        {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
      </nav>
    </div>
  </section>

  <!-- 2 · Studio -->
  <section class="section theme-light" id="studio" data-theme-section="light" aria-labelledby="studio-title">
    <div class="container">
      <div class="pin-scene" data-pin>
        <span class="orb" aria-hidden="true"></span>
        <p class="eyebrow center" data-reveal id="studio-title" style="margin-bottom:1.5rem">Discover our studio</p>
        <p class="studio__statement" data-words>
        At <strong>Ira Hospitality</strong>, we curate <strong>extraordinary hospitality experiences</strong>, with bespoke solutions that turn hotels, restaurants and lifestyle spaces into <strong>guest-centric destinations.</strong>
        </p>
      </div>
      <div class="studio__grid">
        <div class="media studio__media" data-clip>
          <Picture src={img('about-studio-team.jpg')} alt="Indian Durbar menu with gold cutlery and coaster on marble, designed by Ira Hospitality" widths={[480, 720, 1024]} sizes="(min-width: 900px) 40vw, 92vw" formats={['avif', 'webp']} class="parallax-img" data-parallax />
          <div class="studio__sig glass-dark" data-reveal>
            <span class="dot"><Icon name="sparkle" /></span>
            <span><strong>Passionately creating</strong> <span class="muted">design wonders:</span><br /><strong>Unleashing</strong> <span class="muted">boundless creativity</span></span>
          </div>
        </div>
        <div class="studio__note" data-reveal>
          <p>A team of industry leaders bringing design innovation, marketing strategy and operational excellence to every project, with world-class standards in hospitality management, concept development and brand positioning.</p>
          <div><Button href="/about/">About the studio</Button></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Services (glass bento) -->
  <section class="section theme-soft" data-theme-section="light" aria-labelledby="services-title" style="overflow:clip">
    <div class="aurora aurora--low" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="services-title" data-split>Where <span class="light">Hospitality</span><br />Finds Its <span class="light">Voice.</span></h2>
        <p data-reveal>Helping hotels and restaurants speak with clarity, creativity and purpose.</p>
        <div data-reveal><a href="/services/" class="link-arrow">What we do <Icon name="arrow-right" /></a></div>
      </div>
      <div class="svc-bento" data-bento>
        {services.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="svc-card glass" data-glow data-tilt>
            <div class="svc-card__top">
              <span class="svc-card__num" aria-hidden="true">0{i + 1}</span>
              <span class="round-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
            </div>
            <div>
              <h3 class="svc-card__title">{s.titleBold}{s.titleLight && <> <span class="light">{s.titleLight}</span></>}</h3>
              <p class="svc-card__text">{s.short}</p>
              <ul class="svc-card__tags" role="list">{s.highlights.slice(0, 3).map((h) => <li class="chip">{h}</li>)}</ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · Selected work (horizontal reel) -->
  <div class="theme-soft" style="padding-bottom:clamp(0.5rem,1.2vw,1.25rem)">
    <section class="section reel theme-dark tile" data-theme-section="dark" data-reel aria-labelledby="work-title">
      <div class="container reel__head">
        <div>
          <p class="eyebrow" data-reveal>Selected work</p>
          <h2 class="h2" id="work-title" data-split>Designing a <span class="light">Better</span><br />World <span class="light">Today</span></h2>
        </div>
        <a href="/projects/" class="link-arrow" data-reveal>View all projects <Icon name="arrow-right" /></a>
      </div>
      <div class="reel__track" role="region" aria-label="Project gallery, scroll sideways" tabindex="0">
        {reelProjects.map((p) => (
          <div class="reel__item"><ProjectCard project={p} sizes="(min-width: 900px) 30vw, 74vw" reveal={false} /></div>
        ))}
        <div class="reel__end glass">
          <p class="h3">Explore <span class="light">the full portfolio</span></p>
          <Button href="/projects/">View all</Button>
        </div>
      </div>
      <div class="reel__foot" aria-hidden="true">
        <span class="reel__count"><b data-reel-index>01</b> / {String(reelProjects.length).padStart(2, '0')}</span>
        <div class="reel__progress"><span></span></div>
      </div>
    </section>
  </div>

  <!-- 5 · Founders -->
  <section class="section theme-light" data-theme-section="light" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Meet our team · The founders</p>
        <h2 class="h2" id="team-title" data-split>Shaping the Future <span class="light">of Hospitality</span></h2>
        <p data-reveal><strong style="color:var(--fg);font-weight:600">A three-dimensional approach to excellence</strong>, merging expertise in operations, marketing strategy and design for unparalleled hospitality branding.</p>
        <p data-reveal style="font-size:var(--fs-body)">Ira Hospitality is led by Suhasini and Siddarth, whose combined experience bridges brand thinking, culinary insight and commercial execution.</p>
      </div>

      <div class="founders-grid">
        {founders.map((f, i) => <FounderCard founder={f} id={`founder-${i}`} />)}
      </div>

      <div class="base" data-reveal>
        <p>Headquartered in <strong>Hyderabad, India</strong> · Operating <strong>Globally</strong></p>
        <Button href="/about/">Read more about us</Button>
      </div>
    </div>
  </section>

  <!-- 6 · Client voice -->
  <section class="section theme-soft" data-theme-section="light" aria-labelledby="voice-title" style="overflow:clip">
    <div class="aurora" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Client voice</p>
        <h2 class="h2" id="voice-title" data-split>Hear What <span class="light">They Say!</span></h2>
        <p data-reveal>Customer reviews are a valuable source of information for both businesses and consumers.</p>
      </div>

      <div class="voices glass" data-voices data-reveal>
        <div class="voices__stage">
          {testimonials.map((t, i) => (
            <div class="voice" role="tabpanel" id={`voice-panel-${i}`} aria-labelledby={`voice-tab-${i}`} hidden={i !== 0}>
              <figure>
                <Icon name="quote" class="voice__mark" />
                <blockquote>
                  <p class="voice__pull">“{t.pull}”</p>
                  <details class="voice__full">
                    <summary>Read the full review</summary>
                    <p>{t.quote}</p>
                  </details>
                </blockquote>
                <figcaption class="voice__who">
                  <img src={img(t.logo).src} width="64" height="64" alt={t.logoAlt} loading="lazy" decoding="async" />
                  <span><strong>{t.name}</strong><span>{t.org}</span></span>
                </figcaption>
              </figure>
            </div>
          ))}
        </div>
        <div class="voices__nav">
          <div class="voices__tabs" role="tablist" aria-label="Choose a testimonial">
            {testimonials.map((t, i) => (
              <button class="voices__tab" type="button" role="tab" id={`voice-tab-${i}`} aria-controls={`voice-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} aria-label={`${t.name}, ${t.org}`}>
                <img src={img(t.logo).src} width="56" height="56" alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
          <div class="voices__arrows">
            <button class="icon-btn" type="button" data-prev aria-label="Previous testimonial"><Icon name="arrow-left" /></button>
            <button class="icon-btn" type="button" data-next aria-label="Next testimonial"><Icon name="arrow-right" /></button>
          </div>
        </div>
      </div>
    </div>

    <div class="clients">
      <p class="container" data-reveal>Hotels, restaurants and brands we’ve worked with</p>
      <div class="marquee" data-marquee>
        {clientRows.map((row, r) => (
          <div class="marquee__track" data-dir={r % 2 ? 1 : -1}>
            {[0, 1, 2, 3].map((k) => (
              <div class="marquee__group" aria-hidden={k > 0 ? 'true' : undefined}>
                {row.map((n) => <span>{n}</span>)}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · Contact -->
  <section class="section theme-light" id="contact" data-theme-section="light" aria-labelledby="contact-title" style="overflow:clip">
    <div class="aurora aurora--low" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container contact-grid">
      <div>
        <h2 class="h2" id="contact-title" data-split>Let’s Start <span class="light">Something New.</span></h2>
        <p class="lead" style="margin-top:1.5rem" data-reveal>Ready to take your brand to the next level? We’re here to help you shape the future of hospitality.</p>
        <dl class="contact-list" data-reveal>
          <div><dt>Contact</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt>Visit us</dt><dd><a href={site.mapsLink} target="_blank" rel="noopener">{site.address.lines.join(', ')}</a></dd></div>
        </dl>
      </div>
      <div class="form-card" data-reveal>
        <ContactForm source="home_page" idPrefix="home" />
      </div>
    </div>
  </section>
</Base>
