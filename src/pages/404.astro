---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" noindex headerTheme="light" footerCta={false}>
  <section class="page-hero theme-light" data-theme-section="light" style="min-height:80svh;display:grid;align-items:center">
    <div class="aurora" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
    <div class="container page-hero__inner">
      <p class="pill-label glass" data-intro><span class="dot" aria-hidden="true"></span>Error 404</p>
      <h1 class="h1" style="margin-top:1.5rem" data-split="intro">Page <span class="light">not found.</span></h1>
      <p class="lead" style="margin-top:1.5rem" data-intro>The page you’re looking for doesn’t exist or has moved.</p>
      <div class="hero__actions" data-intro>
        <Button href="/">Back to home</Button>
        <Button href="/projects/" variant="ghost">See our work</Button>
      </div>
    </div>
  </section>
</Base>
