---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { img } from '../../data/images';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;
const [first, ...rest] = p.name.split(' | ');
// Group the gallery: full-width images stand alone, runs of half-width images flow as masonry.
const segments: { full: boolean; items: typeof p.gallery }[] = [];
for (const g of p.gallery) {
  const full = g.span === 'full';
  const last = segments[segments.length - 1];
  if (!full && last && !last.full) last.items.push(g);
  else segments.push({ full, items: [g] });
}
const og = p.cover ? (await getImage({ src: img(p.cover), width: 1200, height: 630, fit: 'cover', position: 'center', format: 'jpg' })).src : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: p.name,
    headline: p.headline,
    description: `${p.headline} ${p.summary}`,
    genre: p.category,
    keywords: p.tags.join(', '),
    creator: { '@id': `${site.url}/#organization` },
    url: `${site.url}/projects/${p.slug}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Portfolio', item: `${site.url}/projects/` },
      { '@type': 'ListItem', position: 3, name: p.name, item: `${site.url}/projects/${p.slug}/` },
    ],
  },
];
---
<Base title={p.name} description={`${p.headline} ${p.summary}`.slice(0, 158)} image={og} headerTheme="light" label="Projects" jsonLd={jsonLd}>
  <section class="proj-hero theme-light hairlines" data-theme-section="light">
    <div class="container">
      <a href="/projects/" class="back-link" data-intro><Icon name="arrow-left" />Back to projects</a>
      <p class="eyebrow" data-intro>{p.category}</p>
      <h1 class="proj-hero__title" style="margin-top:1.5rem" data-split="intro">
        {first}{rest.length > 0 && <><span class="sep"> / </span><span class="light">{rest.join(' | ')}</span></>}
      </h1>
      <dl class="proj-hero__meta" data-intro>
        <div><dt>Services</dt><dd>{p.tags.join(', ')}</dd></div>
        <div><dt>Category</dt><dd>{p.category}</dd></div>
        <div><dt>Location</dt><dd>{p.location ?? '—'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section theme-light" data-theme-section="light" aria-labelledby="story-title" style="padding-top:clamp(1rem,3vw,2rem)">
    <div class="container proj-story">
      <div class="proj-story__text">
        <h2 id="story-title" data-split>{p.headline}</h2>
        <p data-reveal>{p.summary}</p>
      </div>
      {p.cover && (
        <div class="media media--portrait" data-clip>
          <Picture src={img(p.cover)} alt={`${p.name} key visual`} widths={[480, 800, 1100]} sizes="(min-width: 960px) 46vw, 92vw" formats={['avif', 'webp']} loading="eager" class="parallax-img" data-parallax />
        </div>
      )}
    </div>
  </section>

  <section class="theme-light" data-theme-section="light" aria-label={`${p.name} gallery`} style="padding-bottom:var(--section)">
    <div class="container">
      {p.gallery.length ? (
        <div class="gallery">
          {segments.map((seg) => seg.full ? (
            <figure class="gallery__item" data-reveal>
              <Picture src={img(seg.items[0].src)} alt={seg.items[0].alt} widths={[640, 1024, 1600]} sizes="(min-width: 1300px) 1240px, 92vw" formats={['avif', 'webp']} loading="lazy" />
            </figure>
          ) : (
            <div class="gallery__cols">
              {seg.items.map((g) => (
                <figure class="gallery__item" data-reveal>
                  <Picture src={img(g.src)} alt={g.alt} widths={[480, 800, 1100]} sizes="(min-width: 700px) 46vw, 92vw" formats={['avif', 'webp']} loading="lazy" />
                </figure>
              ))}
            </div>
          ))}
        </div>
      ) : (
        <div class="placeholder-panel" data-reveal>
          <p class="h3" style="color:var(--black)">Project imagery coming soon</p>
          <p style="margin-top:1rem">In the meantime, ask us about this project.</p>
          <div style="margin-top:2rem"><Button href="/contact/">Contact us</Button></div>
        </div>
      )}
    </div>
  </section>

  <a href={`/projects/${next.slug}/`} class="proj-next theme-dark" data-theme-section="dark">
    <div class="container">
      <span class="eyebrow proj-next__label">Next project</span>
      <span class="proj-next__title" style="display:block">{next.name.split(' | ')[0]}</span>
    </div>
    <span class="round-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
  </a>
</Base>
