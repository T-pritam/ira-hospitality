---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../data/images';
import type { Project } from '../data/projects';
interface Props { project: Project; eager?: boolean; sizes?: string; reveal?: boolean }
const { project: p, eager = false, sizes = '(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 92vw', reveal = true } = Astro.props;
---
<a href={`/projects/${p.slug}/`} class="pcard" data-cursor="View" data-reveal={reveal ? '' : undefined} data-tilt={reveal ? '' : undefined}>
  <div class="pcard__media">
    {p.cover ? (
      <Picture src={img(p.cover)} alt="" widths={[400, 640, 900, 1200]} sizes={sizes} formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <div class="pcard__placeholder" aria-hidden="true"><div><strong>{p.name}</strong><span>Images coming soon</span></div></div>
    )}
    <div class="pcard__meta glass-dark">
      <span class="pcard__cat">{p.category}</span>
      <h3 class="pcard__name">{p.name}</h3>
      <span class="round-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>
    </div>
  </div>
  <span class="pcard__tags">{p.tags.join(' · ')}</span>
</a>
