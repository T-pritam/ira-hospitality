---
import Dodeca from './Dodeca.astro';
import Icon from './Icon.astro';
interface Crumb { label: string; href?: string }
interface Props {
  crumbs: Crumb[];
  theme?: 'dark' | 'light';
  cue?: { label: string; href: string };
  id?: string;
}
const { crumbs, theme = 'light', cue, id } = Astro.props;
const color = theme === 'dark' ? 'rgba(255,255,255,0.28)' : 'rgba(0,0,0,0.2)';
---
<section class={`page-hero hairlines theme-${theme}`} data-theme-section={theme} id={id}>
  <Dodeca class="page-hero__canvas" color={color} drift={12} />
  <div class="container page-hero__inner">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb" role="list" data-intro>
        <li><a href="/">Homepage</a></li>
        {crumbs.map((c) => (
          <>
            <li aria-hidden="true">/</li>
            <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          </>
        ))}
      </ol>
    </nav>
    <h1 class="h1" data-split="intro"><slot /></h1>
    <div class="page-hero__foot">
      <div class="lead" data-intro><slot name="lead" /></div>
      {cue && (
        <a href={cue.href} class="scroll-cue" data-intro>
          <span class="scroll-cue__circle"><Icon name="arrow-down" /></span>{cue.label}
        </a>
      )}
    </div>
  </div>
</section>
