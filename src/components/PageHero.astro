---
import Icon from './Icon.astro';
interface Crumb { label: string; href?: string }
interface Props {
  crumbs: Crumb[];
  /** Kept for callers; the page hero is always light now. */
  theme?: 'dark' | 'light';
  cue?: { label: string; href: string };
  id?: string;
}
const { crumbs, cue, id } = Astro.props;
---
<section class="page-hero theme-light" data-theme-section="light" id={id}>
  <div class="aurora" aria-hidden="true" data-aurora><i></i><i></i><i></i></div>
  <div class="container page-hero__inner">
    <nav aria-label="Breadcrumb" data-intro>
      <ol class="breadcrumb glass" role="list">
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => (
          <>
            <li aria-hidden="true">/</li>
            <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          </>
        ))}
      </ol>
    </nav>
    <h1 class="h1" data-split="intro"><slot /></h1>
    <div class="page-hero__foot">
      <div class="lead" data-intro><slot name="lead" /></div>
      {cue && (
        <a href={cue.href} class="scroll-cue glass" data-intro>
          <span class="scroll-cue__circle"><Icon name="arrow-down" /></span>{cue.label}
        </a>
      )}
    </div>
  </div>
</section>
