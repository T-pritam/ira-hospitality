---
// Inline SVG icon set (no icon font download).
type Name =
  | 'arrow-right' | 'arrow-left' | 'arrow-down' | 'arrow-up' | 'arrow-up-right'
  | 'instagram' | 'facebook' | 'mail' | 'phone' | 'pin' | 'quote' | 'check' | 'alert'
  | 'upload' | 'sparkle' | 'search' | 'clock' | 'briefcase';
interface Props { name: Name; class?: string; size?: number }
const { name, class: cls, size } = Astro.props;
const s = size ? { width: size, height: size } : {};
---
<svg class={cls} {...s} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow-right' && <path d="M4 12h16M14 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H4M10 6l-6 6 6 6" />}
  {name === 'arrow-down' && <path d="M12 4v16M6 14l6 6 6-6" />}
  {name === 'arrow-up' && <path d="M12 20V4M6 10l6-6 6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'instagram' && (<><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></>)}
  {name === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" />}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>)}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'pin' && (<><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'quote' && <path fill="currentColor" stroke="none" d="M3 21v-7.2C3 8.5 5.6 5 10.6 3.5l1 2.1C8.9 6.7 7.6 8.6 7.4 11.2H11V21H3zm10 0v-7.2c0-5.3 2.6-8.8 7.6-10.3l1 2.1c-2.7 1.1-4 3-4.2 5.6H21V21h-8z" />}
  {name === 'check' && (<><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></>)}
  {name === 'alert' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 16.5v.5" /></>)}
  {name === 'upload' && (<><path d="M12 15V4M7 9l5-5 5 5" /><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" /></>)}
  {name === 'sparkle' && <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6" />}
  {name === 'search' && (<><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {name === 'briefcase' && (<><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" /></>)}
</svg>
