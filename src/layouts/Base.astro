---
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import logoGold from '../assets/logo-gold.png';
import { Image } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Theme of the first section, so the header starts in the right colour */
  headerTheme?: 'dark' | 'light';
  /** Vertical page label at bottom-left (signature of the original site) */
  label?: string;
  preloader?: boolean;
  /** Hide the big "Let's talk" block in the footer (pages that already end with a contact form) */
  footerCta?: boolean;
}
const { title, description, image, noindex, jsonLd, headerTheme = 'dark', label, preloader = false, footerCta = true } = Astro.props;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO title={title} description={description} image={image} noindex={noindex} jsonLd={jsonLd} />
    <script is:inline>
      // Enable motion styles only when JS runs and the visitor allows motion.
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        try { if (sessionStorage.getItem('ira-visited')) d.classList.add('no-preload'); } catch (e) {}
        // Safety net: never leave content hidden if scripts fail to load.
        setTimeout(function () { if (!d.classList.contains('motion-ready')) d.classList.add('reveal-all'); }, 4000);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {preloader && (
      <div class="preloader" data-preloader aria-hidden="true">
        <div class="preloader__logo"><Image src={logoGold} alt="" width={228} height={140} format="webp" loading="eager" /></div>
        <div class="preloader__bar"><span></span></div>
      </div>
    )}
    <Header theme={headerTheme} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer cta={footerCta} />
    {label && <div class="rail-label" aria-hidden="true">{label}</div>}
    <a href="#main" class="to-top" data-to-top aria-label="Back to top">
      <span class="to-top__circle"><Icon name="arrow-up" size={16} /></span>
      <span class="to-top__text">Back to top</span>
    </a>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
